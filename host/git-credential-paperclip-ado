#!/usr/bin/env node
// Git credential helper for Azure DevOps. Asks the Paperclip plugin for a short-lived token with the run's own agent identity.
// Nothing is stored: git gets the token on stdout and keeps it in memory for that command. Plain node, no HOME, no config files.
'use strict';
const PLUGIN_KEY = process.env.PAPERCLIP_ADO_PLUGIN_KEY || 'mzaferyahsi.azure-devops';
const action = process.argv[2];
if (action !== 'get') { drain(); process.exit(0); } // store and erase are no-ops: nothing is ever saved
function drain() { process.stdin.resume(); process.stdin.on('data', () => {}); }
function fail(message) { process.stderr.write(`paperclip-ado: ${message}\n`); process.exit(1); }

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { input += c; if (input.length > 8192) fail('credential request too large'); });
process.stdin.on('end', async () => {
  const req = {};
  for (const line of input.split('\n')) { const i = line.indexOf('='); if (i > 0) req[line.slice(0, i)] = line.slice(i + 1); }
  if (!req.protocol || !req.host) fail('git did not say which host it wants a credential for');
  if (!req.path) fail('git sent no repository path (credential.useHttpPath must be true; use the paperclip git wrapper)');
  const key = process.env.PAPERCLIP_API_KEY;
  const base = (process.env.PAPERCLIP_API_URL || '').replace(/\/+$/, '').replace(/\/api$/, '');
  if (!key || !base) fail('this shell has no Paperclip run identity (PAPERCLIP_API_KEY / PAPERCLIP_API_URL are missing); run git from inside an agent run');
  const headers = { 'content-type': 'application/json', authorization: `Bearer ${key}` };
  if (process.env.PAPERCLIP_RUN_ID) headers['x-paperclip-run-id'] = process.env.PAPERCLIP_RUN_ID;
  let res, body;
  try {
    res = await fetch(`${base}/api/plugins/${PLUGIN_KEY}/api/git/credentials`, { method: 'POST', headers, body: JSON.stringify({ protocol: req.protocol, host: req.host, path: req.path }), signal: AbortSignal.timeout(15000), redirect: 'error' });
    body = await res.json().catch(() => ({}));
  } catch { fail('could not reach Paperclip to get a credential'); }
  if (res.status !== 200 || typeof body.password !== 'string') fail(`${body && body.message ? body.message : `credential request failed (HTTP ${res.status})`}`);
  const out = [`username=${body.username || 'paperclip'}`, `password=${body.password}`];
  if (Number.isInteger(body.expiresAt)) out.push(`password_expiry_utc=${body.expiresAt}`);
  process.stdout.write(out.join('\n') + '\n');
});
